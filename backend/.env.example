# HTTP
PORT=4000
PUBLIC_WEB_ORIGIN=http://localhost:3000

# Postgres (RLS enabled). Leave DATABASE_URL empty to run the in-memory demo mode.
DATABASE_URL=postgres://sathi:sathi@localhost:5432/sathi
PG_POOL_MAX=10

# Redis / BullMQ + Socket.IO adapter. Leave empty for in-process fallback.
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me
OTP_TTL_SECONDS=300
DEMO_OTP=482913
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=

# Payments
PAYMENT_WEBHOOK_SECRET=change-me
